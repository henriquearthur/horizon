# Conexão com o GitLab. Copie para .env.local e preencha.
# O token precisa do escopo `api`; ele fica só no servidor.
HORIZON_GITLAB_URL=https://gitlab.exemplo.com
HORIZON_GITLAB_TOKEN=glpat-...

# Opcionais — os padrões servem para a maioria das instalações.
# Onde o Escopo escolhido é gravado.
# HORIZON_DATA_FILE=.horizon/scope.json
# Por quanto tempo a lista de issues lida do GitLab é reaproveitada (ms).
# HORIZON_ISSUES_TTL_MS=60000
# Idem para grupos, projetos, membros e labels (ms).
# HORIZON_CATALOG_TTL_MS=600000
# De quanto em quanto tempo o navegador busca a Inbox de novo (ms).
# VITE_HORIZON_POLL_INTERVAL_MS=120000
